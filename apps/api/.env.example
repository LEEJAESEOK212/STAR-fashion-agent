APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://brown_chat:brown_chat@localhost:5432/brown_chat
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_URL=http://localhost:3000
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/kakao/callback
MASTER_ACCESS_KEY_HASH=
MASTER_GUEST_COOKIE_MAX_AGE_DAYS=365

# OpenAI-compatible Chat Completions API
CHAT_API_BASE_URL=
CHAT_API_KEY=
CHAT_API_MODEL=
CHAT_API_TIMEOUT_SECONDS=60
CHAT_API_TEMPERATURE=0.7
CHAT_CONTEXT_MESSAGE_LIMIT=3
CHAT_SYSTEM_PROMPT=당신은 Brown-Chat의 친절하고 사려 깊은 AI 어시스턴트입니다. 사용자가 다른 언어로 답해 달라고 명시적으로 요청하지 않는 한, 모든 답변은 자연스러운 한국어로만 작성하세요.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=brown_chat_turns
EMBEDDING_API_BASE_URL=http://localhost:7511
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_VECTOR_SIZE=1024
EMBEDDING_TIMEOUT_SECONDS=30
CHAT_MEMORY_TOP_K=3
CHAT_MEMORY_SCORE_THRESHOLD=0.0
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ATTACHMENTS_PER_MESSAGE=5
ATTACHMENT_TEXT_MAX_CHARACTERS=30000
VLM_IMAGE_MAX_DIMENSION=2048
VLM_IMAGE_MAX_BYTES=2097152
VLM_IMAGE_JPEG_QUALITY=85
VLM_IMAGE_TEMPERATURE=0.2
WHISPER_API_BASE_URL=http://localhost:8080
WHISPER_LANGUAGE=ko
WHISPER_TIMEOUT_SECONDS=120
VOICE_UPLOAD_MAX_BYTES=26214400

