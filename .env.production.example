# Tailscale Funnel hostname only. Do not include https:// or a trailing slash.
# Check it with: tailscale status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))'
DOMAIN=spark-name.tailnet-name.ts.net

# Cloudflare 배포를 선택할 때만 사용합니다. Tailscale Funnel에는 필요 없습니다.
CLOUDFLARE_TUNNEL_TOKEN=

# Use long random values. DATABASE_URL password must be URL-encoded when needed.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://brown_chat:replace-with-a-long-random-password@postgres:5432/brown_chat
JWT_SECRET_KEY=replace-with-at-least-64-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Kakao production application credentials. Never commit real values.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# SHA-256 hash only. Never store the plaintext shared access key in this file.
MASTER_ACCESS_KEY_HASH=
MASTER_GUEST_COOKIE_MAX_AGE_DAYS=365

# Brown-Chat을 DGX Spark에 함께 배포할 때 사용하는 Docker host 주소입니다.
# vLLM의 인증 없는 7510 포트는 외부 인터넷에 절대 공개하지 않습니다.
CHAT_API_BASE_URL=http://host.docker.internal:7510
CHAT_API_KEY=
CHAT_API_MODEL=google/gemma-4-26B-A4B-it
CHAT_API_TIMEOUT_SECONDS=180
CHAT_API_TEMPERATURE=0.7
CHAT_CONTEXT_MESSAGE_LIMIT=3
CHAT_SYSTEM_PROMPT=당신은 Brown-Chat의 친절하고 사려 깊은 AI 어시스턴트입니다. 사용자가 다른 언어로 답해 달라고 명시적으로 요청하지 않는 한, 모든 답변은 자연스러운 한국어로만 작성하세요. 답변은 GitHub Flavored Markdown으로 작성하고 제목, 목록, 표, 인용문, 인라인 코드와 코드 블록은 내용을 더 명확하게 만들 때만 사용하세요.
QDRANT_COLLECTION=brown_chat_turns
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_VECTOR_SIZE=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_GPU_MEMORY_UTILIZATION=0.1
EMBEDDING_MAX_MODEL_LEN=2048
HF_CACHE_DIR=/home/ai-010/.cache/huggingface
CHAT_MEMORY_TOP_K=3
CHAT_MEMORY_SCORE_THRESHOLD=0.0
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ATTACHMENTS_PER_MESSAGE=5
ATTACHMENT_TEXT_MAX_CHARACTERS=30000
VLM_IMAGE_MAX_DIMENSION=2048
VLM_IMAGE_MAX_BYTES=2097152
VLM_IMAGE_JPEG_QUALITY=85
VLM_IMAGE_TEMPERATURE=0.2
WHISPER_MODEL=small
WHISPER_LANGUAGE=ko
WHISPER_THREADS=8
WHISPER_TIMEOUT_SECONDS=120
VOICE_UPLOAD_MAX_BYTES=26214400

WEB_CONCURRENCY=2
